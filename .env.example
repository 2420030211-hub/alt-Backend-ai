# ==============================================================================
# Environment Configuration - Banking Complaint Management Backend
# ==============================================================================

# Server Configuration
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
JWT_SECRET=super-secret-development-jwt-key-replace-in-production-min32chars
SESSION_SECRET=session-secret-development-key-replace-in-prod

# Demo Accounts for Testing
DEMO_EMPLOYEE_ID=EMP1001
DEMO_EMPLOYEE_EMAIL=employee@demo.local
DEMO_EMPLOYEE_PASSWORD=Employee@123
DEMO_EMPLOYEE_NAME=Demo Compliance Officer

# AI Service Microservices Endpoints
CORA_SERVICE_URL=http://localhost:8001
QWEN_SERVICE_URL=http://localhost:8002

# Fallback / Mock settings (true if running without GPU or offline)
AI_MOCK_FALLBACK=true
CORA_MOCK_FALLBACK=true
QWEN_MOCK_FALLBACK=true

# Model Parameters
CORA_CONFIDENCE_THRESHOLD=0.65
QWEN_MODEL_NAME=Qwen/Qwen3-4B
QWEN_MAX_TOKENS=512
QWEN_TEMPERATURE=0.2
